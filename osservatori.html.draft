<script>
  document.getElementById('year').textContent = new Date().getFullYear();

  (function initPaywall() {
    const backdrop = document.getElementById('paywall');
    if (!backdrop) return;
    const targetName = document.getElementById('paywall-target-name');

    function openPaywall(name) {
      if (name) targetName.textContent = 'Osservatorio ' + name;
      backdrop.classList.add('is-open');
      document.body.style.overflow = 'hidden';
    }
    function closePaywall() {
      backdrop.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.oss-card.is-locked').forEach(card => {
      card.addEventListener('click', (e) => {
        e.preventDefault();
        openPaywall(card.dataset.lockedName || '');
      });
    });

    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) closePaywall();
    });
    backdrop.querySelector('.paywall-close').addEventListener('click', closePaywall);
    backdrop.querySelectorAll('[data-paywall-close]').forEach(b => b.addEventListener('click', closePaywall));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && backdrop.classList.contains('is-open')) closePaywall();
    });
  })();
</script>
</body>
</html>
