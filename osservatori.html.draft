<!-- PAYWALL MODAL -->
<div class="paywall-backdrop" id="paywall" role="dialog" aria-modal="true" aria-labelledby="paywall-title">
  <div class="paywall-modal">
    <button class="paywall-close" type="button" aria-label="Chiudi">×</button>
    <span class="paywall-icon" aria-hidden="true">🔒</span>
    <h3 id="paywall-title">Osservatorio riservato</h3>
    <p class="paywall-target">Stai accedendo all'<span id="paywall-target-name">Osservatorio</span></p>
    <p>
      Questo Osservatorio è <strong>esclusivo per chi sostiene Neutralia</strong>
      con un abbonamento di <strong>5 € al mese</strong>.
    </p>
    <p>
      Il tuo contributo finanzia la ricerca attiva del Centro Studi sulla sovranità italiana —
      l'<em>unica via possibile</em> per ottenere una vera neutralità bellica.
    </p>
    <div class="paywall-price">
      5 € <small>/ mese</small>
    </div>
    <div class="paywall-actions">
      <a href="dona.html" class="paywall-btn paywall-btn-primary">Sostieni Neutralia →</a>
      <button type="button" class="paywall-btn paywall-btn-secondary" data-paywall-close>Torna agli Osservatori</button>
    </div>
  </div>
</div>

